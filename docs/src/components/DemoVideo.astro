---
// A recorded demo from docs/public/videos, described by its entry in
// src/data/videos.json (published by docs/recordings/publish.mjs). Emits a
// schema.org VideoObject so search engines can index the clip.
import { existsSync } from 'node:fs';
import videos from '../data/videos.json';

interface Props {
  name: keyof typeof videos;
  /** Start playing (muted, looped) as soon as the page loads. */
  autoplay?: boolean;
}

const { name, autoplay = false } = Astro.props;
const video = videos[name];
if (!video) throw new Error(`DemoVideo: no entry "${String(name)}" in src/data/videos.json`);
if (!video.duration) throw new Error(`DemoVideo: "${String(name)}" is not published yet (run make demo NAME=${String(name)})`);

// The mp4/webm files are docs-media release assets that the build fetches
// into public/videos (make docs-media); posters and captions are in git.
for (const file of Object.values(video.files)) {
  if (!existsSync(new URL(`../../public/videos/${file}`, import.meta.url))) {
    throw new Error(`DemoVideo: public/videos/${file} is missing; fetch the videos with make docs-media`);
  }
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (file: string) => `${base}/videos/${file}`;
const src = (ext: string) => asset(ext === 'webm' || ext === 'mp4' ? video.files[ext] : `${String(name)}.${ext}`);
const absolute = (ext: string) => new URL(src(ext), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: video.description,
  thumbnailUrl: absolute('webp'),
  contentUrl: absolute('mp4'),
  uploadDate: video.uploadDate,
  duration: video.duration,
};
---

<figure class="demo-video">
  <video
    controls
    muted
    loop
    playsinline
    preload="metadata"
    autoplay={autoplay}
    poster={src('webp')}
    aria-label={video.title}
  >
    <source src={src('webm')} type="video/webm" />
    <source src={src('mp4')} type="video/mp4" />
    {video.captions && <track kind="captions" src={src('vtt')} srclang="en" label="English" default />}
  </video>
  <figcaption><strong>{video.title}.</strong> {video.description}</figcaption>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</figure>

<style>
  .demo-video {
    margin: 1.5rem 0;
  }
  .demo-video video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    background: #1e1e2e;
  }
  .demo-video figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
