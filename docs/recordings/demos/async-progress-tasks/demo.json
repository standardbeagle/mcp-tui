{
  "name": "async-progress-tasks",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "cardBrand": {
    "name": "mcp-tui",
    "sub": "standard beagle"
  },
  "brand": {
    "image": "../../assets/sb-logo-on-dark.png",
    "position": "top-right",
    "width": 170,
    "opacity": 0.9
  },
  "setup": {
    "upstream": "../../stage.mjs",
    "waitFor": "http://127.0.0.1:7690/"
  },
  "segments": [
    {
      "id": "card-intro",
      "type": "card",
      "dur": 3.5,
      "kicker": "mcp-tui",
      "title": "Progress, server logs, tasks and subscriptions",
      "sub": "What a server says while it works: progress, logs, task status, resource updates."
    },
    {
      "id": "progress",
      "type": "browser",
      "raw": true,
      "url": "http://127.0.0.1:7690/",
      "script": "./progress.mjs",
      "keep": [
        [
          "mark:ready",
          "end"
        ]
      ]
    },
    {
      "id": "card-task",
      "type": "card",
      "dur": 2.4,
      "kicker": "MCP tasks",
      "title": "Call now, fetch later",
      "sub": "Run a tool as a task and follow its status to the result."
    },
    {
      "id": "task",
      "type": "browser",
      "raw": true,
      "url": "http://127.0.0.1:7690/",
      "script": "./task.mjs",
      "keep": [
        [
          "mark:ready",
          "end"
        ]
      ]
    },
    {
      "id": "card-watch",
      "type": "card",
      "dur": 2.4,
      "kicker": "subscriptions",
      "title": "Follow a resource as it changes",
      "sub": "One line per notifications/resources/updated."
    },
    {
      "id": "watch",
      "type": "browser",
      "raw": true,
      "url": "http://127.0.0.1:7690/",
      "script": "./watch.mjs",
      "keep": [
        [
          "mark:ready",
          "end"
        ]
      ]
    }
  ]
}
