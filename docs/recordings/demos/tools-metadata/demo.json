{
  "name": "tools-metadata",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "cardBrand": {
    "name": "mcp-tui",
    "sub": "standard beagle"
  },
  "brand": {
    "image": "../../assets/sb-logo-on-dark.png",
    "position": "top-right",
    "width": 170,
    "opacity": 0.9
  },
  "setup": {
    "upstream": "../../stage.mjs",
    "waitFor": "http://127.0.0.1:7690/"
  },
  "segments": [
    {
      "id": "card-intro",
      "type": "card",
      "dur": 3.5,
      "kicker": "mcp-tui",
      "title": "Tool metadata at a glance",
      "sub": "Callable names, titles, annotations and output schemas, and a check before anything destructive."
    },
    {
      "id": "tools",
      "type": "browser",
      "raw": true,
      "url": "http://127.0.0.1:7690/",
      "script": "./tools.mjs",
      "keep": [
        [
          "mark:ready",
          "end"
        ]
      ]
    }
  ]
}
