{
  "name": "schema-validation",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "cardBrand": {
    "name": "mcp-tui",
    "sub": "standard beagle"
  },
  "brand": {
    "image": "../../assets/sb-logo-on-dark.png",
    "position": "top-right",
    "width": 170,
    "opacity": 0.9
  },
  "setup": {
    "upstream": "../../stage.mjs",
    "waitFor": "http://127.0.0.1:7690/"
  },
  "segments": [
    {
      "id": "card-intro",
      "type": "card",
      "dur": 3.5,
      "kicker": "mcp-tui",
      "title": "Schema validation before the call goes out",
      "sub": "Arguments are checked against the tool's whole input schema; the error names the argument and the rule."
    },
    {
      "id": "cli",
      "type": "browser",
      "raw": true,
      "url": "http://127.0.0.1:7690/",
      "script": "./cli.mjs",
      "keep": [
        [
          "mark:ready",
          "end"
        ]
      ]
    },
    {
      "id": "card-tui",
      "type": "card",
      "dur": 2.4,
      "kicker": "TUI",
      "title": "The form checks too",
      "sub": "Refused in the form, or sent on purpose with Ctrl+O to see the server's answer."
    },
    {
      "id": "tui",
      "type": "browser",
      "raw": true,
      "url": "http://127.0.0.1:7690/",
      "script": "./tui.mjs",
      "keep": [
        [
          "mark:ready",
          "end"
        ]
      ]
    }
  ]
}
