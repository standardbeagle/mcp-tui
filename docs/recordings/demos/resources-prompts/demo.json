{
  "name": "resources-prompts",
  "viewport": {
    "width": 1600,
    "height": 900
  },
  "cardBrand": {
    "name": "mcp-tui",
    "sub": "standard beagle"
  },
  "brand": {
    "image": "../../assets/sb-logo-on-dark.png",
    "position": "top-right",
    "width": 170,
    "opacity": 0.9
  },
  "setup": {
    "upstream": "../../stage.mjs",
    "waitFor": "http://127.0.0.1:7690/"
  },
  "segments": [
    {
      "id": "card-intro",
      "type": "card",
      "dur": 3.5,
      "kicker": "mcp-tui",
      "title": "Resources, templates and prompts",
      "sub": "Read text and binary resources, complete URI templates, and render prompts with their arguments."
    },
    {
      "id": "resources",
      "type": "browser",
      "raw": true,
      "url": "http://127.0.0.1:7690/",
      "script": "./resources.mjs",
      "keep": [
        [
          "mark:ready",
          "end"
        ]
      ]
    },
    {
      "id": "card-prompts",
      "type": "card",
      "dur": 2.4,
      "kicker": "prompts",
      "title": "Prompts, with completion",
      "sub": "List them, see their arguments, complete a value, run one."
    },
    {
      "id": "prompts",
      "type": "browser",
      "raw": true,
      "url": "http://127.0.0.1:7690/",
      "script": "./prompts.mjs",
      "keep": [
        [
          "mark:ready",
          "end"
        ]
      ]
    }
  ]
}
