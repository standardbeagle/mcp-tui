{
  "name": "@standardbeagle/mcp-tui",
  "version": "0.9.1",
  "description": "A comprehensive Terminal User Interface (TUI) and Command Line Interface (CLI) for Model Context Protocol (MCP) servers with full tool, prompt, and resource management",
  "main": "index.js",
  "bin": {
    "mcp-tui": "bin/mcp-tui.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
    "test": "go test ./...",
    "build": "go build -o bin/mcp-tui .",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/standardbeagle/mcp-tui.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tui",
    "terminal",
    "cli",
    "ai",
    "llm",
    "tools",
    "prompts",
    "resources",
    "server-testing",
    "debugging",
    "development"
  ],
  "author": "standardbeagle",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/standardbeagle/mcp-tui/issues"
  },
  "homepage": "https://github.com/standardbeagle/mcp-tui#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.2",
    "node-fetch": "^3.3.2"
  },
  "files": [
    "bin/",
    "scripts/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "QUICK_START.md"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}
